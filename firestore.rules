rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserDataByUid(uid) {
      return get(/databases/$(database)/documents/users_by_uid/$(uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)) && getUserDataByUid(request.auth.uid).role == 'ADMIN';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // --- USERS COLLECTION ---
    match /users/{username} {
      // Profile data is accessible to signed-in users
      allow read: if isSignedIn();
      
      allow create: if (
        isValidId(username) &&
        request.resource.data.username == '@' + username &&
        (!isSignedIn() || request.resource.data.uid == request.auth.uid)
      );

      allow update: if (
        isAdmin() || 
        (isSignedIn() && resource.data.uid == request.auth.uid && 
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginDate', 'streak', 'streakFreezeCount', 'needsStreakProtection', 'previousStreak', 'lastActive', 'progress', 'quizHistory', 'coins', 'level', 'currentExp']))
      );
    }

    // --- USERS_BY_UID COLLECTION ---
    match /users_by_uid/{uid} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && 
        request.resource.data.keys().hasAll(['username', 'role']) &&
        (request.resource.data.role == 'USER' || isAdmin());
    }

    // --- POSTS COLLECTION ---
    match /posts/{postId} {
      allow read: if isSignedIn();
      
      allow create: if (
        isSignedIn() && 
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.content is string && 
        request.resource.data.content.size() <= 1000
      );

      allow update: if (
        isSignedIn() && (
          // Action: Like/Unlike
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) ||
          // Action: Comment
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments'])
        )
      );

      allow delete: if (
        isAdmin() || 
        (isSignedIn() && resource.data.authorId == request.auth.uid) ||
        (isSignedIn() && resource.data.username == getUserDataByUid(request.auth.uid).username)
      );
    }

    // --- STATS COLLECTION ---
    match /stats/{docId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); 
    }
  }
}
