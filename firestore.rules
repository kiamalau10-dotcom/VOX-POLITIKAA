rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        (
          (exists(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)) && 
           (get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data.role == 'ADMIN' || 
            get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data.role == 'admin')) ||
          (request.auth.token.email == "devinapurba23@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    function isValidUser(data) {
      return data.username is string && data.username.size() > 0 &&
             data.displayName is string && data.displayName.size() > 0 &&
             data.role in ['ADMIN', 'USER', 'admin', 'user'];
    }

    // --- RULES ---
    
    // Koleksi Users
    match /users/{username} {
      allow read: if true; 
      allow create: if isValidUser(request.resource.data);
      allow update: if (isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin())) || 
                    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginDate', 'streak', 'streakFreezeCount', 'lastActive', 'uid']));
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);
    }

    // Koleksi VoxCircle (Posts)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isAdmin() || resource.data.authorId == request.auth.uid || resource.data.userId == request.auth.uid);
      
      // PERBAIKAN: Izinkan Admin menghapus apa saja (untuk fitur Nuke)
      // User biasa hanya bisa hapus jika ID mereka cocok dengan authorId atau userId
      allow delete: if isAdmin() || 
                    (isAuthenticated() && (
                      (exists(resource.data.authorId) && resource.data.authorId == request.auth.uid) || 
                      (exists(resource.data.userId) && resource.data.userId == request.auth.uid)
                    ));
    }

    // Pemetaan UID ke Username
    match /users_by_uid/{uid} {
      allow read: if true;
      allow write: if isAuthenticated(); 
    }

    // Statistik Global
    match /stats/{statId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if isAdmin();
    }

    // Feedback dari User
    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // Hasil Quiz
    match /quiz_results/{resultId} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    // Voting / Voice
    match /votes/{voteId} {
      allow read: if true;
      allow create: if isAuthenticated();
    }
    
    // Test Koneksi
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
