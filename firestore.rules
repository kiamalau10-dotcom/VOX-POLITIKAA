rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data.role.upper() == 'ADMIN';
    }

    // --- Entity Validations ---

    function isValidUser(data) {
      return data.username is string && data.username.size() > 0 && data.username.size() <= 50 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role in ['ADMIN', 'USER', 'admin', 'user'];
    }

    function isValidPost(data) {
      return data.username is string && data.username.size() <= 50 &&
             data.content is string && data.content.size() <= 5000 &&
             data.likes is list &&
             data.comments is list &&
             (data.timestamp == request.time || data.timestamp is timestamp || data.timestamp == null);
    }

    // --- Rules ---

    match /users/{username} {
      allow read: if true; 
      allow create: if isValidUser(incoming());
      allow update: if (isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin())) || 
                    (incoming().diff(existing()).affectedKeys().hasOnly(['lastLoginDate', 'streak', 'streakFreezeCount', 'lastActive', 'uid', 'currentExp', 'level', 'coins', 'quizHistory', 'achievements', 'ownedItems', 'avatarConfig', 'equippedCostumeId', 'voxTitle', 'needsStreakProtection', 'previousStreak', 'displayName', 'username', 'role', 'password']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    match /posts/{postId} {
      // EXPLICITLY allow read for everyone to fix the list error
      allow read: if true;
      allow get: if true;
      allow list: if true;

      allow create: if isValidPost(incoming()) && (
        !isSignedIn() || (incoming().username == get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data.username)
      );
      
      allow update: if (isSignedIn() && isValidPost(incoming()) && (
        (incoming().diff(existing()).affectedKeys().hasOnly(['likes', 'comments', 'shares'])) ||
        (existing().username == get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data.username) ||
        isAdmin()
      ));

      allow delete: if isAdmin() || (isSignedIn() && (
        exists(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)) && 
        get(/databases/$(database)/documents/users_by_uid/$(request.auth.uid)).data.username == resource.data.username
      ));
    }

    match /users_by_uid/{uid} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /stats/{statId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /feedbacks/{feedbackId} {
      allow read: if isAdmin();
      allow create: if true;
      allow delete: if isAdmin();
    }

    match /quiz_results/{resultId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if true;
      allow delete: if isAdmin();
    }

    match /votes/{voteId} {
      allow read: if true;
      allow create: if true;
    }

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /_connection_test_/{docId} {
      allow read: if true;
    }
  }
}
