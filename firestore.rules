rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fungsi pembantu
    function isAuthenticated() {
      return request.auth != null;
    }

    // Rules untuk postingan VoxCircle
    match /posts/{postId} {
      allow read: if true;
      // Izinkan membuat post asal sudah login
      allow create: if isAuthenticated();
      // Izinkan hapus/edit jika dia Admin atau pemilik asli post tersebut
      allow update, delete: if isAuthenticated() && (
        request.auth.token.email == "devinapurba23@gmail.com" || 
        resource.data.authorId == request.auth.uid || 
        resource.data.userId == request.auth.uid
      );
    }

    // Rules untuk data user (Penting agar login lancar)
    match /users/{username} {
      allow read, write: if true;
    }

    match /users_by_uid/{uid} {
      allow read, write: if true;
    }

    // Rules cadangan untuk fitur lain
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
