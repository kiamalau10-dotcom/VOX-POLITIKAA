{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile and progress data.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "password": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "level": { "type": "number" },
        "currentExp": { "type": "number" },
        "streak": { "type": "number" },
        "lastLoginDate": { "type": "string" },
        "progress": { "type": "object" },
        "quizHistory": { "type": "array" },
        "coins": { "type": "number" },
        "streakFreezeCount": { "type": "number" },
        "uid": { "type": "string" },
        "lastActive": { "type": "string" }
      },
      "required": ["username", "displayName", "role"]
    },
    "UserByUid": {
      "title": "User UID Mapping",
      "description": "Mapping from Firebase Auth UID to username and role for security rules.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] }
      },
      "required": ["username", "role"]
    },
    "Post": {
      "title": "VoxCircle Post",
      "description": "A post in the VoxCircle social feed.",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "displayName": { "type": "string" },
        "avatarConfig": { "type": "object" },
        "content": { "type": "string" },
        "timestamp": { "type": "object" },
        "likes": { "type": "array" },
        "comments": { "type": "array" },
        "role": { "type": "string", "enum": ["ADMIN", "USER"] },
        "shares": { "type": "number" },
        "authorId": { "type": "string" }
      },
      "required": ["username", "content", "timestamp"]
    },
    "GlobalStats": {
      "title": "Global Statistics",
      "description": "Aggregated application statistics.",
      "type": "object",
      "properties": {
        "totalUsers": { "type": "number" },
        "activeUsers": { "type": "number" },
        "totalVotes": { "type": "number" },
        "totalQuizzesTaken": { "type": "number" }
      }
    }
  },
  "firestore": {
    "users/{username}": {
      "schema": "User",
      "description": "Collection of user profiles."
    },
    "users_by_uid/{uid}": {
      "schema": "UserByUid",
      "description": "Security mapping for role validation."
    },
    "posts/{postId}": {
      "schema": "Post",
      "description": "VoxCircle feed posts."
    },
    "stats/global": {
      "schema": "GlobalStats",
      "description": "Global application statistics."
    }
  }
}
